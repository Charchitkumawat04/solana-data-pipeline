# Any Solana JSON-RPC endpoint. The public one works with no signup (rate-limited).
# Faster options: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY  or a Tatum/QuickNode URL.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Where the DuckDB warehouse lives. Default matches the dbt-solana-models profile.
DUCKDB_PATH=../dbt/solana_warehouse.duckdb
